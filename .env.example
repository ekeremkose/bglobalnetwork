# Copy to .env.local for local development; on Vercel set these per environment
# (Production / Preview) in Project Settings -> Environment Variables.
# Never commit real values. Use SEPARATE values (separate database, blob store, OAuth client) for staging and production.

# --- Admin access -----------------------------------------------------------------------
# Secret that signs session cookies. Generate: openssl rand -base64 32
AUTH_SECRET=
# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Concealed admin path: 16-64 chars, lowercase letters/digits/hyphens. Generate: openssl rand -hex 16
# The admin lives at https://<your-domain>/<this value>. It is not linked or listed anywhere.
ADMIN_BASE_PATH=

# --- Content storage --------------------------------------------------------------------
# Neon Postgres connection string (pooled). Required on Vercel; there is no in-memory fallback there.
DATABASE_URL=
# Local development only: 1 = keep content in server memory when DATABASE_URL is empty. Ignored on Vercel.
ALLOW_MEMORY_STORE=

# --- Reel cover uploads -----------------------------------------------------------------
# Vercel Blob read/write token of the matching store (created automatically when you connect a Blob store to the project).
BLOB_READ_WRITE_TOKEN=
